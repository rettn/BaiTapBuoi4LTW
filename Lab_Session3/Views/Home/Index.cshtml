@model IEnumerable<Lab_Session3.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="shop-layout">

    <!-- DANH MỤC BÊN TRÁI -->
    <aside class="sidebar">
        <partial name="_Taskbar" model="ViewBag.DanhMuc" />

        <div class="banner">
            <img src="~/images/banner.png" alt="Banner" />
        </div>
    </aside>

    <!-- NỘI DUNG BÊN PHẢI -->
    <main class="main-content">

        <!-- SẢN PHẨM MỚI NHẤT -->
        <div class="section-title">
            Sản phẩm mới nhất
        </div>

        <div class="product-grid">
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <img src="@product.Image" alt="@product.Title" />

                    <h5>@product.Title</h5>
                </div>
            }
        </div>

        <!-- COMPONENT HOT PRODUCT -->
        @await Component.InvokeAsync("HotProduct")

    </main>

</div>